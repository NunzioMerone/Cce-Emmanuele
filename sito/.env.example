# Copiare in .env. La chiave rimane sul server e non viene inclusa in dist.
# Abilitare YouTube Data API v3 e limitare la chiave a questa API.
YOUTUBE_API_KEY=
# Secondi tra sincronizzazioni, avviate alla visita della pagina (minimo 60).
YOUTUBE_CACHE_SECONDS=900
# Per hosting Node: impostare HOST=0.0.0.0 e PORT nella piattaforma di hosting.
HOST=127.0.0.1
PORT=4173

# Invio diretto dei messaggi alla email configurata della chiesa.
# Credenziali solo sul server. Con Gmail usare una password per le app,
# mai la password ordinaria dell’account. Porta 465 = TLS, 587 = STARTTLS.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=cce.emmanuele@gmail.com
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=cce.emmanuele@gmail.com
